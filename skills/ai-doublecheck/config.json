{
  "enabled": true,
  "targets": {
    "codex": true,
    "gemini": true
  },
  "models": {
    "gemini": "gemini-3-pro-preview"
  },
  "perspectives": {
    "code_review": {
      "description": "코드 품질, 가독성, 유지보수성, 설계 패턴",
      "agents": ["codex", "gemini"]
    },
    "qa": {
      "description": "버그, 엣지케이스, 예외 상황, 보안 취약점",
      "agents": ["codex", "gemini"]
    }
  },
  "auto_trigger_keywords": [
    "더블체크",
    "검증해",
    "크로스체크",
    "세컨드 오피니언",
    "다른 AI",
    "확인받아",
    "double check",
    "cross check",
    "verify with"
  ],
  "settings": {
    "parallel": true,
    "max_content_tokens": 500,
    "max_response_tokens": 400,
    "timeout_seconds": 60
  }
}
